{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebChat AI Model Config",
  "type": "object",
  "properties": {
    "base_url": { "type": "string", "description": "OpenAI 兼容 API 根地址，不含 /chat/completions" },
    "model": { "type": "string" },
    "api_key": { "type": "string" },
    "api_format": { "type": "string", "enum": ["completions"], "default": "completions" },
    "active_profile": {
      "type": "string",
      "description": "留空使用顶层字段；填写 profiles 中的 key 则切换配置"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["base_url", "model", "api_key"],
        "properties": {
          "base_url": { "type": "string" },
          "model": { "type": "string" },
          "api_key": { "type": "string" },
          "api_format": { "type": "string" }
        }
      }
    }
  }
}
